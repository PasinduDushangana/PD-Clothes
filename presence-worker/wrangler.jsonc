{
  "name": "pd-clothes-presence",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://pasindudushangana.github.io,http://localhost:8000,http://127.0.0.1:8000"
  },
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "PresenceRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PresenceRoom"] }]
}
